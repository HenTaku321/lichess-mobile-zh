# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/

.flutter-plugins
.flutter-plugins-dependencies

# Code generation output
*.freezed.dart
*.g.dart
*.mocks.dart

custom_lint.log

/split-debug-info/

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# Avoid committing generated Javascript files:
*.dart.js
*.info.json      # Produced by the --dump-info flag.
*.js             # When generated by dart2js. Don't specify *.js if your
                 # project includes source files written in JavaScript.
*.js_
*.js.deps
*.js.map

.DS_Store

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# FVM Version Cache
.fvm/

# VS Code
.vscode/

# Cache directory created by scripts
.cache/

# The Pikafish network: 48 MB, one HTTP request away, and fetched by
# scripts/fetch-pikafish-nnue.sh before every build. Committing it would cost every clone the
# rest of the project's life, and the script checks what it downloads against the size and the
# sha256 in lib/src/model/engine/engine_utils.dart, which git could not do better.
assets/pikafish/
