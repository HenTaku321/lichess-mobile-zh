    "puzzle": ["puzzle.autoNext", "puzzle.rated", "account.showRatings"]
  },
  "stateSets": {
    "remote": ["normal", "empty", "loading", "failure", "retry", "return", "identity", "token-renewal"],
    "paged": ["normal", "empty", "loading", "failure", "retry", "page-two", "tail", "more-failure", "more-retry", "refresh-failure", "refresh-retry", "return", "identity", "token-renewal"],
    "local": ["normal", "return"],
    "menu": ["normal", "disabled", "busy", "cancel", "return"],
    "form": ["normal", "empty", "validation", "loading", "failure", "retry", "busy", "return", "identity"],
    "board": ["normal", "player-move", "opponent-reply", "next-input", "history", "takeback", "hint", "engine-failure", "return"],
    "analysis": ["normal", "mainline", "branch", "switch-branch", "delete-branch", "promote-branch", "engine-failure", "return"],
    "clock": ["normal", "running", "paused", "history", "flipped", "takeback", "ended", "return"],
    "links": ["normal", "unknown-url", "invalid-scheme", "stale-route", "inactive-tab", "identity"],
    "private": ["normal", "empty", "loading", "failure", "retry", "draft", "page-two", "more-failure", "more-retry", "send-failure", "copy", "link", "return", "identity", "token-renewal"],
    "puzzle": ["normal", "correct", "wrong", "hint", "success", "submission-loading", "submission-failure", "retry", "auto-next", "history", "return", "identity"]
  },
  "differences": {
    "board-art": {"kind": "pixels", "roles": ["board-content", "palette"], "reason": "Xiangqi uses its own pieces, river and palace; this is not a chrome/layout exception."},
    "board-aspect": {"kind": "geometry", "roles": ["board-content"], "reason": "The Xiangqi board has nine files and ten ranks; chess has eight by eight."},
    "board-rules": {"kind": "semantics", "roles": [], "reason": "Legal moves, result terminology, notation and allowed positions belong to the actual game rules."},
    "private-capabilities": {"kind": "pixels", "roles": ["appbar"], "reason": "Xiangqi has no proven delete-thread or typing/read-receipt capability; desktop refresh is available instead."},
    "private-status": {"kind": "pixels", "roles": ["appbar"], "reason": "The inbox capture does not establish a peer online/offline flag; no status is invented."},
    "engine-brand": {"kind": "pixels", "roles": ["engine-label"], "reason": "The actual engines are Pikafish and Stockfish, not interchangeable brand labels."},
    "authentication": {"kind": "semantics", "roles": [], "reason": "OAuth/email and Xiangqi multi-step authentication are different verified flows, not fake equivalent forms."},
    "unknown-protocol": {"kind": "semantics", "roles": [], "reason": "An unproven upstream operation is blocked, never simulated as a successful real capability."}
  },
