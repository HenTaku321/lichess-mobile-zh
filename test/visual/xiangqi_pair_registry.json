    "playing": ["board.immersiveModeWhilePlaying", "board.premoves", "board.confirmResignAndDraw", "board.clockPosition", "board.moveListDisplay", "board.materialDifferenceFormat", "account.showRatings", "account.clockTenths", "account.clockSound"],
