{
  "schema": 1,
  "environment": {
    "size": [[480, 480], [1280, 720], [1920, 1080]],
    "locale": ["en-GB", "zh-CN"],
    "mode": ["light", "dark"],
    "textScale": [1, 2],
    "dpi": [1, 2]
  },
