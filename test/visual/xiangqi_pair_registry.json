    "analysis": ["analysis.showEvaluationGauge", "analysis.showEngineLines", "analysis.showBestMoveArrow", "analysis.showAnnotations", "analysis.showPgnComments", "analysis.inlineNotation", "analysis.smallBoard", "analysis.enableServerAnalysis", "engineEvaluation.isEnabled", "engineEvaluation.numEvalLines"],
